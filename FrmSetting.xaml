<Window x:Class="WhimGroupWin.FrmSetting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhimGroupWin 设置"
        Width="720"
        Height="480"
        MinWidth="660"
        MinHeight="440"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F6"
        Foreground="#202A30"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
        <Window.Resources>
                <SolidColorBrush x:Key="AccentBrush"
                                 Color="#087F73"/>
                <Style TargetType="TabItem">
                        <Setter Property="FocusVisualStyle"
                                Value="{x:Null}"/>
                        <Setter Property="DockPanel.Dock"
                                Value="Top"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                        <Setter Property="Margin"
                                Value="8,3"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                                <Border x:Name="NavigationItem"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="0,12">
                                                        <Grid>
                                                                <Border x:Name="Indicator"
                                                                        Width="3"
                                                                        Height="18"
                                                                        HorizontalAlignment="Left"
                                                                        Background="Transparent"
                                                                        CornerRadius="1"/>
                                                                <ContentPresenter ContentSource="Header"
                                                                                  Margin="16,0,12,0"
                                                                                  VerticalAlignment="Center"/>
                                                        </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="NavigationItem"
                                                                        Property="Background"
                                                                        Value="#E6EAEC"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected"
                                                                 Value="True">
                                                                <Setter TargetName="NavigationItem"
                                                                        Property="Background"
                                                                        Value="#DDEEEA"/>
                                                                <Setter TargetName="Indicator"
                                                                        Property="Background"
                                                                        Value="{StaticResource AccentBrush}"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource AccentBrush}"/>
                                                                <Setter Property="FontWeight"
                                                                        Value="SemiBold"/>
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused"
                                                                 Value="True">
                                                                <Setter TargetName="NavigationItem"
                                                                        Property="BorderBrush"
                                                                        Value="{StaticResource AccentBrush}"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
                <Style TargetType="Button">
                        <Setter Property="Background"
                                Value="White"/>
                        <Setter Property="Foreground"
                                Value="#26343A"/>
                        <Setter Property="BorderBrush"
                                Value="#D4DCDF"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="MinHeight"
                                Value="34"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonSurface"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="5"
                                                        Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonSurface"
                                                                        Property="Opacity"
                                                                        Value="0.8"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonSurface"
                                                                        Property="Opacity"
                                                                        Value="0.65"/>
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonSurface"
                                                                        Property="BorderBrush"
                                                                        Value="#202A30"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled"
                                                                 Value="False">
                                                                <Setter TargetName="ButtonSurface"
                                                                        Property="Opacity"
                                                                        Value="0.4"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
                <Style TargetType="CheckBox">
                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>
                        <Setter Property="MinHeight"
                                Value="28"/>
                </Style>
        </Window.Resources>
        <DockPanel>
                <TextBlock Text="WhimGroupWin"
                           DockPanel.Dock="Top"
                           Margin="24,20,24,20"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#17242E"/>
                <TabControl TabStripPlacement="Left"
                            Background="White"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                        <TabControl.Template>
                                <ControlTemplate TargetType="TabControl">
                                        <Grid KeyboardNavigation.TabNavigation="Local">
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="174"/>
                                                        <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ItemsPresenter Grid.Column="0"
                                                                Margin="0,0,0,8"
                                                                KeyboardNavigation.TabIndex="1"/>
                                                <Border Grid.Column="1"
                                                        Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                                                          ContentSource="SelectedContent"
                                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                          KeyboardNavigation.TabIndex="2"/>
                                                </Border>
                                        </Grid>
                                </ControlTemplate>
                        </TabControl.Template>
                        <TabControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                        <DockPanel LastChildFill="False"/>
                                </ItemsPanelTemplate>
                        </TabControl.ItemsPanel>
                        <TabItem Header="常规">
                                <Grid Margin="28,24">
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="常规"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,24"/>
                                        <ListBox x:Name="WindowGroupsList"
                                                        Grid.Row="1"
                                                        BorderThickness="0"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                                <Border BorderBrush="#E5EAEC"
                                                                                BorderThickness="0,0,0,1"
                                                                                Padding="0,12">
                                                                        <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                        <RowDefinition Height="Auto"/>
                                                                                        <RowDefinition Height="Auto"/>
                                                                                </Grid.RowDefinitions>
                                                                                <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{Binding Name}"
                                                                                                FontWeight="SemiBold"
                                                                                           VerticalAlignment="Center"
                                                                                                TextTrimming="CharacterEllipsis"
                                                                                                Margin="0,0,8,0"/>
                                                                                <StackPanel Grid.Column="1"
                                                                                                Orientation="Horizontal">
                                                                                        <Button Width="34"
                                                                                                        Margin="0,0,6,0"
                                                                                                        FontFamily="Segoe MDL2 Assets"
                                                                                                Content="&#xE890;"
                                                                                                        ToolTip="显示组"
                                                                                                        AutomationProperties.Name="显示组"
                                                                                                        Click="OnShowWindowGroup"/>
                                                                                        <Button Width="34"
                                                                                                        Margin="0,0,6,0"
                                                                                                        FontFamily="Segoe MDL2 Assets"
                                                                                                Content="&#xED1A;"
                                                                                                        ToolTip="隐藏组"
                                                                                                        AutomationProperties.Name="隐藏组"
                                                                                                        Click="OnHideWindowGroup"/>
                                                                                        <Button Width="34"
                                                                                                        FontFamily="Segoe MDL2 Assets"
                                                                                                        Foreground="#B42332"
                                                                                                Content="&#xE8BB;"
                                                                                                        ToolTip="关闭组内所有窗口"
                                                                                                        AutomationProperties.Name="关闭组内所有窗口"
                                                                                                        Click="OnCloseWindowGroup"/>
                                                                                </StackPanel>
                                                                                <TextBlock Grid.Row="1"
                                                                                                Grid.ColumnSpan="2"
                                                                                                Text="{Binding Summary}"
                                                                                           FontSize="12"
                                                                                                Foreground="#61717D"
                                                                                                TextWrapping="Wrap"
                                                                                                Margin="0,8,0,0"/>
                                                                        </Grid>
                                                                </Border>
                                                        </DataTemplate>
                                                </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="WindowGroupsEmpty"
                                                        Grid.Row="1"
                                                        Text="暂无窗口组"
                                                   Foreground="#61717D"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                </Grid>
                        </TabItem>
                        <TabItem Header="自动">
                                <Grid Margin="28,24">
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="0,0,0,20">
                                                <Button DockPanel.Dock="Right"
                                                        HorizontalAlignment="Right"
                                                        Click="OnAddAutomaticGroup"
                                                        Padding="12,5"
                                                        ToolTip="新增自动组"
                                                        AutomationProperties.Name="新增自动组">
                                                        <StackPanel Orientation="Horizontal">
                                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                           Text="&#xE710;"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,6,0"/>
                                                                <TextBlock Text="新增"/>
                                                        </StackPanel>
                                                </Button>
                                                <TextBlock Text="自动"
                                                           FontSize="22"
                                                           FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <ListBox x:Name="AutomaticGroupList"
                                                 Grid.Row="1"
                                                 BorderThickness="0"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                                <Grid Margin="0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Margin="0,0,8,0">
                                                                                <TextBlock Text="{Binding Name}"
                                                                                           FontWeight="SemiBold"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Text="{Binding Summary}"
                                                                                           FontSize="12"
                                                                                           Foreground="#61717D"
                                                                                           TextWrapping="Wrap"
                                                                                           Margin="0,5,0,0"/>
                                                                        </StackPanel>
                                                                        <Button Grid.Column="1"
                                                                                Click="OnEditAutomaticGroup"
                                                                                ToolTip="编辑组"
                                                                                AutomationProperties.Name="编辑组"
                                                                                Width="34"
                                                                                Margin="0,0,6,0"
                                                                                FontFamily="Segoe MDL2 Assets"
                                                                                Content="&#xE70F;"/>
                                                                        <Button Grid.Column="2"
                                                                                Click="OnDeleteAutomaticGroup"
                                                                                ToolTip="删除组"
                                                                                AutomationProperties.Name="删除组"
                                                                                Width="34"
                                                                                FontFamily="Segoe MDL2 Assets"
                                                                                Content="&#xE74D;"/>
                                                                </Grid>
                                                        </DataTemplate>
                                                </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="AutomaticStatus"
                                                   Grid.Row="2"
                                                   Foreground="#61717D"
                                                   TextWrapping="Wrap"
                                                   Margin="0,12,0,0"/>
                                </Grid>
                        </TabItem>
                        <TabItem Header="键位控制">
                                <Grid Margin="28,24">
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="键位控制"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,28"/>
                                        <Grid Grid.Row="1">
                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="组合窗口 · 鼠标左键拖动"
                                                           FontWeight="SemiBold"/>
                                                <StackPanel Grid.Row="1"
                                                            Orientation="Horizontal"
                                                            Margin="0,8,0,24">
                                                        <CheckBox x:Name="GroupControl"
                                                                  Content="Ctrl"
                                                                  Margin="0,0,20,0"/>
                                                        <CheckBox x:Name="GroupAlt"
                                                                  Content="Alt"
                                                                  Margin="0,0,20,0"/>
                                                        <CheckBox x:Name="GroupShift"
                                                                  Content="Shift"/>
                                                </StackPanel>
                                                <TextBlock Grid.Row="2"
                                                           Text="切换至上一个窗口"
                                                           FontWeight="SemiBold"/>
                                                <StackPanel Grid.Row="3"
                                                            Orientation="Horizontal"
                                                            Margin="0,12,0,0">
                                                        <CheckBox x:Name="SwitchControl"
                                                                  Content="Ctrl"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,20,0"/>
                                                        <CheckBox x:Name="SwitchAlt"
                                                                  Content="Alt"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,20,0"/>
                                                        <CheckBox x:Name="SwitchShift"
                                                                  Content="Shift"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,20,0"/>
                                                        <ComboBox x:Name="SwitchKey"
                                                                  Width="88"
                                                                  Height="32"
                                                                  VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="KeyboardStatus"
                                                           Grid.Row="4"
                                                           TextWrapping="Wrap"
                                                           Margin="0,12,0,8"
                                                           Foreground="#61717D"/>
                                                <StackPanel Grid.Row="5"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Right">
                                                        <Button Content="恢复默认"
                                                                Click="OnResetKeyboard"
                                                                Padding="12,5"
                                                                Margin="0,0,8,0"/>
                                                        <Button Content="保存"
                                                                Click="OnSaveKeyboard"
                                                                Background="{StaticResource AccentBrush}"
                                                                BorderBrush="{StaticResource AccentBrush}"
                                                                Foreground="White"
                                                                Padding="16,5"/>
                                                </StackPanel>
                                        </Grid>
                                </Grid>
                        </TabItem>
                        <TabItem Header="关于"
                                 DockPanel.Dock="Bottom">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                        <Grid Margin="28,24">
                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="关于"
                                                           FontSize="22"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,24"/>
                                                <StackPanel Grid.Row="1"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <Image Source="/WhimGroupWin;component/ico/whim_group_full.png"
                                                               Width="200"
                                                               Height="200"
                                                               Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               AutomationProperties.Name="WhimGroupWin 图标"/>
                                                        <TextBlock Text="WhimGroup"
                                                                   FontSize="24"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,16,0,0"/>
                                                        <TextBlock Text="whim0w0"
                                                                   FontSize="24"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,16,0,0"/>
                                                        <TextBlock Text="项目地址：https://github.com/whim0w0/WhimGroupWin"
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Center"
                                                                   Foreground="#61717D"
                                                                   Margin="0,16,0,0"/>
                                                </StackPanel>
                                        </Grid>
                                </ScrollViewer>
                        </TabItem>
                </TabControl>
        </DockPanel>
</Window>